import question from '../brain-games.js';

describe("brainEven", function(){
    it("Answer yes if the number is even, otherwise answer no", function(){
         
        const expected = 15;
        const result = operations.multiply(3, 5);
        assert.strictEqual(result, expected);
    });
    it("should add two numbers", function(){
         
        const expected = 16;
        const result = operations.add(9, 7);
        assert.strictEqual(result, expected);
    });
});